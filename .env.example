# C-Suite Advisors Configuration
# Copy this file to .env and fill in your values.

# --- LLM API Configuration ---
# Any OpenAI-compatible API works. Set the base URL and model accordingly.

# OpenAI
OPENAI_API_KEY=

# Or use a compatible provider (OpenRouter, Together, Groq, local, etc.)
# LLM_API_KEY=
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet

# --- Server Configuration ---
PORT=3000
